-- Tạo giao diện thông báo cập nhật
local ScreenGui = Instance.new("ScreenGui")
local Background = Instance.new("Frame")
local TitleLabel = Instance.new("TextLabel")
local ContactLabel = Instance.new("TextLabel")

-- Cấu hình ScreenGui (Hiển thị đè lên game)
ScreenGui.Parent = game.CoreGui -- Hoặc game.Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true

-- Nền đen phủ kín toàn bộ màn hình
Background.Name = "Background"
Background.Parent = ScreenGui
Background.BackgroundColor3 = Color3.fromRGB(0, 0, 0) -- Màu đen
Background.Size = UDim2.new(1, 0, 1, 0)
Background.Position = UDim2.new(0, 0, 0, 0)
Background.BorderSizePixel = 0
Background.ZIndex = 99999

-- Chữ thông báo ở chính giữa màn hình
TitleLabel.Name = "TitleLabel"
TitleLabel.Parent = Background
TitleLabel.BackgroundTransparency = 1
TitleLabel.AnchorPoint = Vector2.new(0.5, 0.5)
TitleLabel.Position = UDim2.new(0.5, 0, 0.45, 0)
TitleLabel.Size = UDim2.new(0.8, 0, 0.1, 0)
TitleLabel.Font = Enum.Font.SourceSansBold
TitleLabel.Text = "ĐÃ CÓ BẢN SCRIPT MỚI!"
TitleLabel.TextColor3 = Color3.fromRGB(255, 50, 50) -- Màu đỏ nổi bật (hoặc đổi thành 255,255,255 nếu muốn màu trắng)
TitleLabel.TextSize = 45
TitleLabel.TextWrapped = true

-- Chữ liên hệ nằm ngay ở phía dưới
ContactLabel.Name = "ContactLabel"
ContactLabel.Parent = Background
ContactLabel.BackgroundTransparency = 1
ContactLabel.AnchorPoint = Vector2.new(0.5, 0.5)
ContactLabel.Position = UDim2.new(0.5, 0, 0.55, 0)
ContactLabel.Size = UDim2.new(0.8, 0, 0.08, 0)
ContactLabel.Font = Enum.Font.SourceSansItalic
ContactLabel.Text = "Để lấy bản mới, vui lòng liên hệ: Nguyễn Văn Nhật"
ContactLabel.TextColor3 = Color3.fromRGB(200, 200, 200) -- Màu xám trắng
ContactLabel.TextSize = 25
ContactLabel.TextWrapped = true
